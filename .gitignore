# Local SQLite catalogue database (generated by backend import script) + logs
backend/data/*
!backend/data/alharamain.sqlite
backend/*.log
backend/*.err

# Phase K — production deployment artifacts (never commit these):
# SQLite backups (may contain real product/business data, and are large)
backend/backups/
# rotating backend log files
deployment/windows/logs/
backend/*.log.*
# tracked PID file written by start-production.ps1
deployment/windows/*.pid
# real (non-example) QR codes point at the real store address — never commit
deployment/qr/*.png
deployment/qr/*.svg
!deployment/qr/.gitkeep
 
