# Al Haramain backend — environment template (Phase K).
# Copy to backend/.env and fill in real values for THIS machine.
# backend/.env is gitignored — never commit real secrets.

# --- App ---------------------------------------------------------------- #
APP_ENV=production
HOST=0.0.0.0
PORT=8000
# The address customers'/staff phones will actually use, e.g.
# http://<STORE-IP>:8000 . Used only for documentation/QR generation, not
# read by the backend itself.
PUBLIC_ORIGIN=http://<STORE-IP>:8000

# --- Database ------------------------------------------------------------ #
# Optional override — by default the catalogue DB resolves relative to
# backend/catalogue_db.py (backend/data/alharamain.sqlite), independent of
# the process's working directory. Only set this to move the DB elsewhere.
# DATABASE_PATH=C:/al-haramain/data/alharamain.sqlite

# --- CORS / admin CSRF origin allow-list --------------------------------- #
# Comma-separated. In same-origin production (backend serves the built
# frontend) this can just be PUBLIC_ORIGIN; it exists mainly for local dev
# (CRA on :3000) and any split-origin setup.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional — only set this if the admin panel is served from an origin
# different than CORS_ORIGINS. Falls back to CORS_ORIGINS when unset.
# TRUSTED_ADMIN_ORIGINS=

# --- Admin session cookie ------------------------------------------------ #
# false = supported HTTP-on-isolated-LAN mode (recommended default for this
# store, see deployment/README.md "HTTPS decision"). true = cookie requires
# real HTTPS or browsers will silently drop it.
COOKIE_SECURE=false
ADMIN_SESSION_HOURS=12

# --- Logging -------------------------------------------------------------- #
LOG_LEVEL=INFO
# Optional — set to enable rotating file logs (5MB x 5 backups). Leave unset
# to log to stdout only (captured by start-production.ps1 into a log file
# regardless).
# LOG_FILE=deployment/windows/logs/backend.log

# --- Backups --------------------------------------------------------------#
# How many timestamped catalogue backups backup_catalogue.py keeps.
BACKUP_RETENTION=14

# --- Legacy Mongo-backed subsystem (cart/admin-legacy — NOT the catalogue) #
# These are inherited from an earlier phase and only affect the unused
# Mongo-backed cart/legacy-admin code paths in server.py, not the SQLite
# catalogue (Phase I+) that customers/admin actually use. Leaving Mongo
# unreachable is fine — those code paths are wrapped in try/except and the
# catalogue API is unaffected. Do not point this at a real Mongo unless you
# specifically need the legacy subsystem.
#
# Route exposure: this whole legacy router (cart/products/collections/
# site-settings/fragrance-finder/track-visitor/legacy admin login+CRUD+
# reseed) is OFF by default when APP_ENV=production, ON by default
# otherwise. Set ENABLE_LEGACY_API explicitly to override either way.
# ENABLE_LEGACY_API=false
#
# Legacy admin login (username/password, separate from the Phase J
# PIN-based /api/admin/auth/*). No hardcoded default credentials — if both
# are unset, legacy login stays unseeded/unavailable (401 on any attempt).
# Only set these if you actually need the legacy Mongo admin panel.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
MONGO_URL=mongodb://localhost:27017/
DB_NAME=al_harmain
JWT_SECRET=change-me-to-a-long-random-value
